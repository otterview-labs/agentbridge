ASB_HTTP_HOST=127.0.0.1
ASB_HTTP_PORT=8787
ASB_ALLOWED_HTTP_HOSTS=
# Required for non-loopback binding: 32-4096 visible ASCII characters, without spaces.
ASB_API_TOKEN=
ASB_LOG_LEVEL=info
ASB_DATA_DIR=./data
ASB_DB_PATH=
ASB_HUB_SESSION_NAME=codex-hub
ASB_CODEX_BIN="codex --no-alt-screen"
ASB_CLAUDE_BIN=claude
ASB_GEMINI_BIN=gemini
ASB_AUTO_CONFIRM_WORKSPACE_TRUST=false
ASB_SUPERVISOR_ENABLED=true
ASB_SUPERVISOR_INTERVAL_MS=15000
ASB_SUPERVISOR_TAIL_LINES=80
ASB_DEFAULT_TAIL_LINES=120
ASB_ALLOWED_WORKSPACE_ROOTS=/path/to/your/projects
ASB_FEISHU_ENABLED=false
ASB_FEISHU_APP_ID=
ASB_FEISHU_APP_SECRET=
ASB_FEISHU_REPLY_IN_THREAD=true
ASB_FRPC_BIN=
ASB_FRP_DOWNLOAD_BASE=https://github.com/fatedier/frp/releases/download
ASB_FRP_VERSION=0.61.1
ASB_FEISHU_ALLOWED_OPEN_IDS=
ASB_FEISHU_ALLOWED_CHAT_IDS=
ASB_FEISHU_NOTIFY_CHAT_IDS=
ASB_FEISHU_GROUP_PREFIX=
ASB_SERVER_MANAGER_PATH=../server-manager
ASB_SERVER_MANAGER_CONFIG=servers_config.json
ASB_PYTHON_BIN=python3
ASB_VOICE_ENGINE=local-whisper
ASB_WHISPER_BIN=whisper-cli
ASB_WHISPER_MODEL=~/.cache/whisper.cpp/ggml-base.bin
ASB_WHISPER_TIMEOUT_MS=45000
# Pi studio is opt-in and read-only. Never reuse SSH or CLI OAuth credentials here.
# Provider: anthropic or openrouter. Set an exact model ID from that provider.
ASB_PI_ENABLED=false
ASB_PI_PROVIDER=
ASB_PI_MODEL=
ASB_PI_API_KEY=
ASB_PI_BASE_URL=
