{
  "name": "agentbridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Manage local Codex, Claude Code, and Gemini CLI sessions with tmux, a web UI, CLI, HTTP API, and optional Feishu integration.",
  "type": "module",
  "homepage": "https://github.com/otterview-labs/agentbridge#readme",
  "bugs": {
    "url": "https://github.com/otterview-labs/agentbridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterview-labs/agentbridge.git"
  },
  "keywords": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "self-hosted",
    "sqlite",
    "tmux",
    "typescript"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "agentbridge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx src/cli.ts",
    "dev:server": "tsx src/server.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/cli.js",
    "start:server": "node dist/server.js",
    "check": "npm run typecheck && npm test && npm run clean && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "diff": "^9.0.0",
    "isomorphic-git": "^1.42.2",
    "partial-json": "0.1.7",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
